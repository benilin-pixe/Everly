{
  "version": 2,
  "builds": [
    {
      "src": "server.ts",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/server.ts"
    },
    {
      "source": "/ws",
      "destination": "/server.ts"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/dist/$1"
    }
  ]
}
